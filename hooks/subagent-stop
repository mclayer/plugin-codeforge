#!/usr/bin/env bash
# SPDX-License-Identifier: MIT (file structure adapted from superpowers v5.1.0)
# SubagentStop hook for codeforge plugin — verify-before-trust advisory + ledger row
#
# Carrier: CFP-1743 (Story-3 of Epic CFP-1740 — ADR-115 §결정 2·3·5)
#
# 책임 경계 (ADR-115 §결정 2 / §결정 3 / §결정 5 정합):
#   - subagent return 시점 verify-before-trust (ADR-070) advisory (stderr)
#   - back-translation gate (ADR-071 §결정 17) 위반 ledger row + 경고
#   - stop-event-v1 v1.0 ledger row append (hook_source: subagent-stop, record-only)
#   - ledger write: ${CLAUDE_PROJECT_DIR}/.claude/ledger/stop-event.jsonl
#   - **block 금지** (ADR-115 §결정 2) — stdout JSON 안 block field 절대 미등장
#   - exit code 항상 0 (graceful degradation)
#
# 정적 properties (ADR-115 §결정 5 / ADR-038 §결정 7·8 정합):
#   (a) set -euo pipefail + exit 0 trap — 어떤 fail 도 SubagentStop block 금지
#   (b) stdout 출력 없음 — block/permissionDecision:deny 절대 미등장
#   (c) network call 0
#   (d) Python 호출 — ADR-061 Amendment 3 외부 .py 파일 (heredoc 금지)
#
# Graceful degradation 5층 (ADR-115 §결정 5 closed-set):
#   (a) hook 파일 부재 → harness skip (본 파일 존재 시 N/A)
#   (b) bash interpreter 부재 → run-hook.cmd `exit /b 0` silent fail-open
#   (c) Python 부재 / 오류 → stderr warning + exit 0
#   (d) stdin 읽기 실패 → 빈 stop_reason 으로 fallback
#   (e) 어떤 fail 도 SubagentStop block 금지
#
# Bypass:
#   BYPASS_CODEFORGE_SUBAGENT_STOP=1 → stderr audit echo + exit 0 (ledger 미작성)
#
# one-channel rule (ADR-115 §결정 3):
#   marker: [codeforge-wrapper-subagent-stop]
#
# Sibling hook axis:
#   hooks/stop = Stop 담당 (stop-time advisory + ledger)
#   본 hook    = SubagentStop 담당 (subagent return verify-before-trust advisory + ledger)

set -euo pipefail

# 어떤 실패도 exit 0 으로 trap — SubagentStop block 금지 (ADR-115 §결정 2·5)
trap 'exit 0' ERR

# ── Bypass check (audit trail 의무) ──────────────────────────────────────────
if [ "${BYPASS_CODEFORGE_SUBAGENT_STOP:-0}" = "1" ]; then
  >&2 printf '[codeforge-wrapper-subagent-stop] BYPASS_CODEFORGE_SUBAGENT_STOP=1 — subagent-stop hook suppressed at %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  exit 0
fi

# ── stdin = SubagentStop hook JSON payload 읽기 ───────────────────────────────
PAYLOAD="$(cat 2>/dev/null || true)"

# stop_reason 추출
STOP_REASON=""
if command -v python3 >/dev/null 2>&1; then
  STOP_REASON="$(printf '%s' "${PAYLOAD}" | python3 -c "
import json, sys
try:
    data = json.loads(sys.stdin.read())
    reason = data.get('stop_reason', '')
    if not reason:
        # subagent-stop 전용 — subagent 완료 여부
        if data.get('subagent_completed', False):
            reason = 'subagent_completed'
        else:
            reason = 'subagent_stopped'
    print(reason, end='')
except Exception:
    pass
" 2>/dev/null || true)"
elif command -v python >/dev/null 2>&1; then
  STOP_REASON="$(printf '%s' "${PAYLOAD}" | python -c "
import json, sys
try:
    data = json.loads(sys.stdin.read())
    reason = data.get('stop_reason', '')
    if not reason:
        if data.get('subagent_completed', False):
            reason = 'subagent_completed'
        else:
            reason = 'subagent_stopped'
    print(reason, end='')
except Exception:
    pass
" 2>/dev/null || true)"
fi

# ── session_id 결정 ───────────────────────────────────────────────────────────
SESSION_ID="${CLAUDE_SESSION_ID:-}"
if [ -z "$SESSION_ID" ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  SESSION_ID="$(basename "${CLAUDE_PROJECT_DIR}")"
fi

# ── ledger path 결정 ──────────────────────────────────────────────────────────
LEDGER_FILE=""
if [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  LEDGER_FILE="${CLAUDE_PROJECT_DIR}/.claude/ledger/stop-event.jsonl"
fi

# ── ADR-070 verify-before-trust advisory (stderr) ────────────────────────────
# SubagentStop hook = subagent return 시점 verify-before-trust advisory reminder
>&2 printf '[codeforge-wrapper-subagent-stop] ADVISORY: ADR-070 verify-before-trust — subagent output ground-truth verify 의무\n'
>&2 printf '  Orchestrator = subagent artifacts verbatim Read + mismatch reject + §10 FP count tally.\n'
>&2 printf '  ADR-071 §결정 17 back-translation gate: [USER-UTTERANCE-VERBATIM] block 유무 확인.\n'

# ── agent_type / agent_id 추출 블록 제거 (CFP-2850 FIX Iter 2 / F-CR-013 죽은 코드) ──
# 구 블록은 spawn-event row-write(RETIRED — Amendment 4) 전용 입력이었고, retire 이후
# 어떤 소비처도 없는 write-only 변수(AGENT_TYPE/AGENT_ID)였다. SubagentStop 마다 Python
# 인터프리터를 4회 fork 하는 순수 낭비 → 제거. stop-event append 는 이 값을 쓰지 않는다
# (--hook-source/--stop-reason/--session-id/--ledger-path 만 전달).

# ── Python verifier 경로 결정 ─────────────────────────────────────────────────
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-}"
APPEND_SCRIPT=""

if [ -n "$PLUGIN_ROOT" ] && [ -f "${PLUGIN_ROOT}/scripts/lib/append_stop_event.py" ]; then
  APPEND_SCRIPT="${PLUGIN_ROOT}/scripts/lib/append_stop_event.py"
elif [ -f "scripts/lib/append_stop_event.py" ]; then
  APPEND_SCRIPT="scripts/lib/append_stop_event.py"
fi

# ── ledger row append ─────────────────────────────────────────────────────────
if [ -z "$LEDGER_FILE" ]; then
  >&2 printf '[codeforge-wrapper-subagent-stop] WARN: CLAUDE_PROJECT_DIR unset — ledger append skipped\n'
  exit 0
fi

if [ -z "$APPEND_SCRIPT" ]; then
  >&2 printf '[codeforge-wrapper-subagent-stop] WARN: append_stop_event.py not found — ledger append skipped\n'
  exit 0
fi

PYTHON_CMD=""
if command -v python3 >/dev/null 2>&1; then
  PYTHON_CMD="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_CMD="python"
fi

if [ -z "$PYTHON_CMD" ]; then
  >&2 printf '[codeforge-wrapper-subagent-stop] WARN: Python interpreter not found — ledger append skipped\n'
  exit 0
fi

# append 실행 — hook_source: subagent-stop
"$PYTHON_CMD" "$APPEND_SCRIPT" \
  --hook-source "subagent-stop" \
  --stop-reason "${STOP_REASON}" \
  --session-id "${SESSION_ID}" \
  --ledger-path "${LEDGER_FILE}" \
  2>/dev/null || true

# ── spawn-event row-write RETIRED (CFP-2850 Amendment 4, OQ-4/OQ-6) ───────────
# 구 SubagentStop spawn-event row-write 는 retire 됐다 — writer topology 가
# Orchestrator task-notification 수신 시점 single-write 로 이동(계약 §3 append_rules.writer
# Amendment 4). 이전 hook path 는 story_key/lane_label/실측/outcome source 부재로
# 전 row 가 vacuous(story_key=""/lane_label="없음", 실측 0, opt-in OFF=0행) 였고,
# 보존 시 event_id cross-path 불일치(hook spawn_seq="" ≠ Orchestrator causal-state seq)로
# read-time dedup 이 collide 못해 이중계수(AC-12 위반) → 구조적 제거가 정답(single-writer).
#
# ── 대신: 경량 disjoint spawn-completion COUNTER (F-B — 설계리뷰 P2 흡수) ──────
# hook 이 crash 에도 발화하는 platform-trigger 이점을 bare count 로 보존한다(InfraOp
# §7.4.2 dissent 부분 수용). 이 counter 는 **spawn-event row-writer 가 아니다** —
# event_id·attribution·lane-context·dedup 전부 불요, spawn-event.jsonl 와 **disjoint 채널**
# (.claude/ledger/spawn-completion.count — INV-3 무위반, spawn-event row 아님). numeric/
# timestamp only(transcript·identity 미포함 — privacy-safe). task-notification-recorded
# row count 와의 COUNT-레벨 reconcile(reconcile_spawn_completion_count.py)로
# `hook_completion_count > recorded_row_count` gap = single-writer survivorship residual
# (Orchestrator-side emit 실패/notification-loss)을 crash-safe 하게 관측(record-only, gate 아님).
# ★관측 범위 = **opt-in ON 구간 한정**(아래 gate). opt-in OFF 구간은 counter·row 양쪽이 0 이라
# 애초에 관측 대상이 아니다(측정 공백이지 gap 아님 — 정직 표기는 reconcile §honesty).
#
# ★opt-in GATED (CFP-2850 구현리뷰 FIX Iter 2 — F-CR-001, ArchitectPL 판정 (a) 확정):
# 구 구현은 이 counter 를 opt-in gate **밖**에 두고 "opt-in-INDEPENDENT BY DESIGN" 이라
# 선언했다. 그 결과 telemetry OFF(기본값) 세션에서도 `.claude/ledger/spawn-completion.count`
# 파일이 생성돼 **ADR-043 §결정 1 opt-in default false**(telemetry OFF = 계측 산출물 0)를
# 위반했다 — counter 도 host-local 계측 산출물이므로 예외가 아니다. 이제 counter 는
# spawn-event 채널과 **동일 술어**(telemetry.enabled AND channels.spawn_event)에 종속한다.
#   - gate 판정 = `append_spawn_event._opt_in_enabled` **재사용** (신규 gate mechanism 0 —
#     ADR-140 reuse-before-write; config 해석 규칙 복제 시 drift 발생).
#   - ★GATE-PROBE ONLY — spawn-event **row-write 는 여전히 RETIRED**. 본 hook 은
#     `_opt_in_enabled` 술어만 평가하며 row 를 append 하지 않는다(append CLI 미호출,
#     --spawn-seq/--ledger-path 등 row 인자 미전달) → single-writer(Orchestrator) 무손상.
#   - **fail-closed**: config read 실패 / 모듈 import 실패 / 인터프리터 부재 = counter 미기록
#     (probe 오류는 stderr WARN 으로 fail-VISIBLE — silent-success 금지).
# reconcile 영향: counter 가 opt-in 종속이 되면서 "opt-in OFF 구간 = counter 도 0" 이 된다
# (reconcile 의 정직 전제 재기술 — reconcile_spawn_completion_count.py §honesty 동반 갱신).
# honest-ceiling: 짧은 1-line append 의 원자성 = 로컬 FS(NTFS/POSIX) best-effort — network
# share 무보장. count = 라인 수(wc -l), record-only advisory 라 미세 오차 허용.
SPAWN_LIB_DIR=""
if [ -n "$PLUGIN_ROOT" ] && [ -f "${PLUGIN_ROOT}/scripts/lib/append_spawn_event.py" ]; then
  SPAWN_LIB_DIR="${PLUGIN_ROOT}/scripts/lib"
elif [ -f "scripts/lib/append_spawn_event.py" ]; then
  SPAWN_LIB_DIR="scripts/lib"
fi

# gate rc: 0 = opt-in ON / 1 = OFF (fail-closed 기본값) / 3 = probe 오류 (fail-closed + WARN)
SPAWN_COUNT_GATE_RC=1
if [ -n "$PYTHON_CMD" ] && [ -n "$SPAWN_LIB_DIR" ]; then
  SPAWN_COUNT_GATE_RC=0
  CODEFORGE_SPAWN_LIB_DIR="$SPAWN_LIB_DIR" "$PYTHON_CMD" -c "
import argparse, os, sys
try:
    sys.path.insert(0, os.environ.get('CODEFORGE_SPAWN_LIB_DIR', ''))
    from append_spawn_event import _opt_in_enabled   # GATE-PROBE ONLY (row-write 아님)
    ns = argparse.Namespace(telemetry_enabled=False, spawn_event_enabled=False)
    sys.exit(0 if _opt_in_enabled(ns) else 1)
except Exception:
    sys.exit(3)
" >/dev/null 2>&1 || SPAWN_COUNT_GATE_RC=$?
fi

# ★S-7 (보안테스트 iter1, P3) — probe 종료코드 WARN 범위 확장.
#   구 조건은 `rc = 3` 만 WARN 했다. probe 는 python -c 를 fork 하므로 3 외에도
#   **127**(인터프리터/모듈 부재 = command not found), **137**(SIGKILL — OOM/강제종료),
#   126(실행 불가) 등이 나올 수 있는데 이들은 전부 "OFF(=1)" 와 구분 없이 조용히 흘러가
#   **probe 가 아예 못 돌았다** 는 사실이 은폐됐다(silent-success-on-error).
#   → 정상 판정 코드 {0=ON, 1=OFF} 밖의 **모든** rc 를 fail-closed + WARN 으로 표면화한다
#   (127/137 을 하드코딩 열거하는 대신 여집합 — 미래 신규 코드도 자동 포착).
if [ "$SPAWN_COUNT_GATE_RC" != "0" ] && [ "$SPAWN_COUNT_GATE_RC" != "1" ]; then
  >&2 printf '[codeforge-wrapper-subagent-stop] WARN: spawn-completion COUNTER opt-in gate 판정 실패 (rc=%s — 3:probe 예외 / 127:인터프리터·모듈 부재 / 137:SIGKILL(OOM) / 기타 미분류) — fail-closed (counter 미기록)\n' "$SPAWN_COUNT_GATE_RC"
elif [ "$SPAWN_COUNT_GATE_RC" = "0" ] && [ -n "${CLAUDE_PROJECT_DIR:-}" ]; then
  SPAWN_COUNT_FILE="${CLAUDE_PROJECT_DIR}/.claude/ledger/spawn-completion.count"
  mkdir -p "${CLAUDE_PROJECT_DIR}/.claude/ledger" 2>/dev/null || true
  printf '%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$SPAWN_COUNT_FILE" 2>/dev/null || true
fi

# ── self-context append (L7 record-only 계측, opt-in gate) ─────────────────────
# Carrier: CFP-2572 Phase 2 / ADR-142 §결정 4 / ADR-043 Amendment 3.
#
# L7 = [measurement] record-only self-context proxy — 게이트 아님, block 금지.
# SubagentStop = spawn/dispatch 경계 → cause_category=spawn-dispatch 로 1 row 기록.
# append_self_context_event.py 가 opt-in(telemetry.enabled AND channels.spawn_event)
# 자체를 gate 함 (config off → no-op). spawn-event.jsonl 공유 ledger 에 append
# (record 판별 = schema_version="self-context-v1").
#
# turn_index proxy: SubagentStop payload/env 에 live per-turn self-context surface
# 부재(platform P1 — ADR-142) → turn_index=0 placeholder 전달. record-only proxy 라
# 정밀 turn 미필수, read-side dedup (session_id, 0) 은 세션당 1 sample 로 proxy replay
# 팽창을 자연 bound (ADR-043 Amd3 (B) 의도 정합). live turn source 가용 시 후속 배선.
#
# fail-VISIBLE (silent-success-on-error 금지): spawn-event 호출과 달리 stderr 를
# /dev/null 로 버리지 않는다 — script 의 "DROPPED" trace 가 surface 하도록. never-block
# 은 `|| true` 로 보장 (exit 0 불변 유지 — ADR-115 §결정 2).
APPEND_SELF_CONTEXT_SCRIPT=""

if [ -n "$PLUGIN_ROOT" ] && [ -f "${PLUGIN_ROOT}/scripts/lib/append_self_context_event.py" ]; then
  APPEND_SELF_CONTEXT_SCRIPT="${PLUGIN_ROOT}/scripts/lib/append_self_context_event.py"
elif [ -f "scripts/lib/append_self_context_event.py" ]; then
  APPEND_SELF_CONTEXT_SCRIPT="scripts/lib/append_self_context_event.py"
fi

if [ -n "$APPEND_SELF_CONTEXT_SCRIPT" ] && [ -n "$PYTHON_CMD" ]; then
  "$PYTHON_CMD" "$APPEND_SELF_CONTEXT_SCRIPT" \
    --session-id "${SESSION_ID}" \
    --turn-index 0 \
    --cause-category spawn-dispatch \
    || true
fi

# ── 429 lease release (CFP-2967 Phase 2 — workerC lease acquire/release) ───────
#
# SubagentStop = subagent 진출 시점 → lease 파일 삭제 (agent_id 단위).
# 유실 = 무해 (reconcile::expire 가 read-time 만료로 흡수).
# fail-open (exit 0 불변).

RELEASE_SCRIPT=""

if [ -n "$PLUGIN_ROOT" ] && [ -f "${PLUGIN_ROOT}/scripts/lib/release_429_lease.py" ]; then
  RELEASE_SCRIPT="${PLUGIN_ROOT}/scripts/lib/release_429_lease.py"
elif [ -f "scripts/lib/release_429_lease.py" ]; then
  RELEASE_SCRIPT="scripts/lib/release_429_lease.py"
fi

# 헬퍼 존재 시 실행
if [ -n "$RELEASE_SCRIPT" ] && [ -n "$PYTHON_CMD" ]; then
  # payload 에서 agent_id 추출 (acquire 와 동일 로직)
  RELEASE_AGENT_ID=""
  if [ -n "${PAYLOAD:-}" ]; then
    RELEASE_AGENT_ID="$(printf '%s' "${PAYLOAD}" | "$PYTHON_CMD" -c "
import json, sys
try:
    data = json.loads(sys.stdin.read())
    sys.stdout.write(data.get('agent_id', ''))
except Exception:
    sys.stdout.write('')
" 2>/dev/null || true)"
  fi

  # agent_id 가 있으면 release 호출
  if [ -n "$RELEASE_AGENT_ID" ]; then
    "$PYTHON_CMD" "$RELEASE_SCRIPT" \
      --agent-id "$RELEASE_AGENT_ID" \
      2>/dev/null || true
  fi
fi

# ── 항상 exit 0 (ADR-115 §결정 2 — block 금지) ───────────────────────────────
exit 0
